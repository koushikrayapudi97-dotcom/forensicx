# ==============================================================================
# ForensicX - Environment Configuration Template
# Tagline: Trace the Evidence. Reveal the Truth.
#
# Copy this file to .env before starting the application in production.
# IMPORTANT: Never commit actual passwords, private keys, or credentials to version control.
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, secure cookie enforcement and strict security header validation are enabled.
FX_ENV=production

# Cookie Security: Set to 'true' in production behind HTTPS (TLS/SSL).
# When true, session cookies are only transmitted over HTTPS connections.
FX_SECURE_COOKIES=true

# Cross-Origin Resource Sharing (CORS): Comma-separated list of trusted client origins.
# Wildcard '*' is strictly prohibited when credentials (cookies) are permitted.
FX_ALLOWED_ORIGINS=https://forensicx.internal,https://localhost:8000

# Rate Limiting: Maximum requests per sliding 60-second window per client IP address.
FX_RATE_LIMIT_LOGIN=15
FX_RATE_LIMIT_REGISTER=10

# Android Debug Bridge (ADB) Configuration
# Path or executable name for the ADB binary used for authorized physical acquisitions.
FX_ADB_EXECUTABLE=adb
FX_ADB_TIMEOUT_SECONDS=10

# Optional AI Investigation Provider: 'disabled', 'local', or 'openai'
# Defaults to 'disabled' (offline evidence correlation engine).
DF_AI_PROVIDER=disabled

